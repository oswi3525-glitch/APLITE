          }
        }
      }
    },
    "Stop voice typing": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng gõ bằng giọng nói"
          }
        }
      }
    },
    "Switch apps": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển app"
          }
        }
