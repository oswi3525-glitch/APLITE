          }
        }
      }
    },
    "Spotlight: apps, files, sums, the web": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight: app, file, phép tính, web"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
