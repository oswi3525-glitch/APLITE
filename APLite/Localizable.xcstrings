    },
    "Added %@ to the desktop.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm %@ vào màn hình nền."
          }
        }
      }
    },
    "Verified %lld bundled module(s). Details are in the system log.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kiểm tra %lld module. Chi tiết trong nhật ký hệ thống."
          }
        }
      }
    },
    "Web Apps are website shortcuts that open in APLite's browser. Native Modules are code bundled and signed together with APLite; they need an official signed build. APLite cannot install arbitrary IPA files from outside — iOS signature and sandbox rules forbid it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Web App là lối tắt trang web mở trong trình duyệt APLite. Module Native là mã được đóng gói và ký cùng APLite, cần bản dựng chính thức. APLite không thể cài IPA tuỳ ý từ bên ngoài — quy tắc ký mã và sandbox của iOS cấm."
          }
        }
      }
    },
    "Drag over the area with the problem": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo qua vùng cần báo lỗi"
