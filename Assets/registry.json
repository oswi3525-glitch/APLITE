{
  "version": "1.3.0",
  "description": "Local asset source library for APLite. Only glyphs referenced by the native registry are kept, with original licences. Files here are NOT bundled into the app; no hotlinking.",
  "hotlinking": false,
  "families": [
    {
      "id": "tabler",
      "name": "Tabler Icons",
      "version": "3.52.0",
      "license": "MIT",
      "licenseFile": "Assets/Icons/Tabler/LICENSE",
      "outlinePath": "Assets/Icons/Tabler/outline",
      "outlineCount": 42,
      "source": "https://github.com/tabler/tabler-icons",
      "attribution": "Copyright (c) 2020-2026 Paweł Kuna",
      "note": "Filtered to the 42 glyphs referenced by the native Asset Registry; upstream full set is available from the source URL."
    },
    {
      "id": "lucide",
      "name": "Lucide Icons",
      "license": "ISC",
      "licenseFile": "Assets/Icons/Lucide/LICENSE",
      "iconPath": "Assets/Icons/Lucide/icons",
      "iconCount": 42,
      "source": "https://github.com/lucide-icons/lucide",
      "attribution": "Copyright (c) 2026 Lucide Icons and Contributors",
      "note": "Filtered to the 42 glyphs referenced by the native Asset Registry; upstream metadata JSON removed to keep the library small."
    }
  ],
  "wallpapers": [
    {
      "asset": "MeadowWallpaper",
      "source": "locally generated",
      "generator": "scripts/generate_meadow.py"
    },
    {
      "asset": "OceanWallpaper",
      "source": "locally generated",
      "generator": "scripts/generate_ocean.py"
    }
  ],
  "nativeRegistry": "APLite/System/AssetRegistry.swift",
