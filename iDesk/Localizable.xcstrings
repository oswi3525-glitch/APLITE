    "A Bluetooth keyboard works right away: pair it in the iPhone's Settings → Bluetooth.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím Bluetooth dùng được ngay: ghép nối trong Cài đặt → Bluetooth của iPhone."
