    "iOS %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %@"
          }
        }
      }
    },
    "iOS apps come from decrypted IPA files: Apps → Add IPA files. The Apps page lists which apps others got working.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App iOS lấy từ file IPA đã giải mã: Ứng dụng → Thêm file IPA. Trang Ứng dụng có danh sách app mọi người đã chạy được."
          }
        }
      }
    },
    "iOS apps run only from decrypted IPA files added to iDesk (next page). Not every app works inside it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App iOS chỉ chạy từ file IPA đã giải mã được thêm vào iDesk (trang sau). Không phải app nào cũng chạy được."
          }
        }
      }
    },
    "iOS only runs code inside an installed app, not from iDesk’s data folder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, không cho nạp từ thư mục dữ liệu của iDesk."
          }
        }
      }
    },
    "iOS only runs code that is inside an installed app, so new apps must be installed into iDesk once: tap the button above, pick ESign (or Feather, Scarlet… whichever signing app you use), then sign and install as usual. Reopen iDesk and the app runs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, nên app mới phải được cài vào iDesk một lần: bấm nút trên, chọn ESign (hoặc Feather, Scarlet… app ký bạn dùng), ký và cài như cài app bình thường. Mở lại iDesk là app chạy."
          }
        }
      }
    },
    "iOS rejected the guest app’s signature.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS từ chối chữ ký của app khách."
          }
        }
      }
    },
    "iOS reports a mouse but sends iDesk no movement. Turn on AssistiveTouch to use it through its pointer.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS báo có chuột nhưng không gửi chuyển động nào cho iDesk. Hãy bật AssistiveTouch để dùng chuột qua con trỏ của nó."
          }
        }
      }
    },
    "iOS reports no mouse to iDesk. On iPhone a mouse is turned on by AssistiveTouch: Settings → Accessibility → Touch → AssistiveTouch, then connect the mouse.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không báo chuột nào cho iDesk. Trên iPhone, chuột được bật bằng AssistiveTouch: Cài đặt → Trợ năng → Cảm ứng → AssistiveTouch, rồi kết nối chuột."
          }
        }
      }
